<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- O app baixa e instala a própria versão nova (ver UpdateInstaller). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: deixa o app atualizar a si mesmo sem o diálogo
         "Atualizar?". Sem ela o sistema ignora o USER_ACTION_NOT_REQUIRED da
         sessão e a atualização fica esperando alguém apertar OK no controle. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Roda em Android TV e em TV box com Android comum (sem leanback nem toque). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- allowBackup=false: um backup restaurado noutra box clonaria a key da TV. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Signage"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Tela inicial: no Android 10+ é o que permite abrir no boot em
                 TV box com Android comum (AOSP), depois de escolhida como
                 padrão. Em Android TV / Google TV certificado o launcher da
                 Google (com.google.android.tvlauncher) fica na frente mesmo
                 com esse papel — ver README, seção "Android TV certificado". -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Só o PendingIntent do próprio app chega aqui. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="false" />

        <!-- Box com Android 9–11 sempre pede confirmação para instalar: este
             serviço aperta "Instalar" na atualização do próprio app. -->
        <service
            android:name=".ConfirmaAtualizacaoService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/confirma_atualizacao" />
        </service>

        <!-- MY_PACKAGE_REPLACED é broadcast protegido do sistema. -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
