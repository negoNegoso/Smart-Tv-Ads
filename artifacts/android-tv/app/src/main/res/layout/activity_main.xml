<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- A WebView entra aqui por código: dá para recriá-la sem refazer a tela. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cobre a página de erro do Chromium enquanto a carga de /tv falha. -->
    <TextView
        android:id="@+id/offline_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:text="@string/offline_message"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/webview_missing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:padding="48dp"
        android:text="@string/webview_missing"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:visibility="gone" />

    <!-- Aviso discreto: o painel segue visível; o diálogo do sistema só abre
         quando alguém aperta OK. -->
    <TextView
        android:id="@+id/update_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="#CC000000"
        android:focusable="false"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Menu do controle. Só aparece quando alguém mexe no controle, para
         não cobrir os anúncios. Cada botão some por conta própria (o grupo
         fica vazio na tela); o foco entra no de sair, e esquerda/direita
         alternam entre os dois. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/exit_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:text="@string/exit_fullscreen"
            android:textColor="@color/texto_do_botao"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/ajustar_imagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:background="#CC000000"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:text="@string/ajustar_imagem"
            android:textColor="@color/texto_do_botao"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tela de ajuste de imagem: padrão de teste ao fundo e, no meio, a
         resolução atual com o caminho para as configurações de tela. Por
         último no arquivo para ficar por cima de tudo. -->
    <FrameLayout
        android:id="@+id/ajuste_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.smarttvads.signage.PadraoDeTesteView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@android:color/black"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ajuste_titulo"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ajuste_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ajuste_como_ler"
                android:textColor="#CCCCCC"
                android:textSize="15sp" />

            <!-- nextFocus prende o foco entre os dois botões: sem isso a
                 seta leva o foco para a WebView escondida atrás. -->
            <Button
                android:id="@+id/ajuste_configuracoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#333333"
                android:nextFocusLeft="@id/ajuste_configuracoes"
                android:nextFocusRight="@id/ajuste_configuracoes"
                android:nextFocusUp="@+id/ajuste_fechar"
                android:nextFocusDown="@+id/ajuste_fechar"
                android:text="@string/ajuste_abrir_configuracoes"
                android:textColor="@color/texto_do_botao"
                android:textSize="18sp" />

            <Button
                android:id="@+id/ajuste_fechar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#333333"
                android:nextFocusLeft="@id/ajuste_fechar"
                android:nextFocusRight="@id/ajuste_fechar"
                android:nextFocusUp="@id/ajuste_configuracoes"
                android:nextFocusDown="@id/ajuste_configuracoes"
                android:text="@string/ajuste_fechar"
                android:textColor="@color/texto_do_botao"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
